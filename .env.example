SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# IDs de usuario de Slack separados por coma (ej. U01ABCDEF,U02GHIJKL)
ALLOWED_SLACK_USERS=
# Opcional: clave de TypeSafe para rutear las menciones sin comando con Jev; sin ella son cambios
TYPESAFE_API_KEY=

# Repos Alfred lists in !repo and the repo picker, and the only ones it infers from (comma separated; empty = every GitHub repo in Orca)
ALFRED_REPOS=fyso-business,fyso-backend,opensource-ingest
